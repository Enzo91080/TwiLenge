# =============================================================
# FORTNITE CHALLENGE HUB - Configuration
# =============================================================
# Copie ce fichier et renomme-le ".env" (sans le .example)
# Remplis les valeurs ci-dessous selon ton setup
# =============================================================

# --- SERVEUR ---
# Port sur lequel tourne le serveur (laisse 3001 par defaut)
PORT=3001

# Chemin vers la base de donnees (laisse par defaut)
DB_PATH=./data/challenge-hub.db

# --- TWITCH (OPTIONNEL) ---
# Si tu ne veux pas d'integration Twitch, laisse ces champs vides.
#
# Pour obtenir ces valeurs :
#   1. Va sur https://dev.twitch.tv/console
#   2. Clique sur "Register Your Application"
#   3. Nom : "Fortnite Challenge Hub" (ou ce que tu veux)
#   4. OAuth Redirect URL : http://localhost:3001/auth/callback
#   5. Category : "Chat Bot"
#   6. Clique sur "Create", puis "Manage"
#   7. Copie le "Client ID" ci-dessous
#   8. Clique sur "New Secret" et copie le secret ci-dessous

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Ton nom d'utilisateur Twitch (en minuscules)
# Exemple : TWITCH_CHANNEL=monstreamer
TWITCH_CHANNEL=

# --- TWITCH BOT ---
# Prefixe des commandes dans le chat (! par defaut)
# Exemple avec ! : !défi, !score, !skip
BOT_PREFIX=!

# Activer/desactiver le bot Twitch (true ou false)
BOT_ENABLED=true

# Activer/desactiver les Channel Points (true ou false)
CHANNEL_POINTS_ENABLED=false

# Nom exact de la recompense Channel Points qui declenche un defi aleatoire
# Tu dois creer cette recompense sur ton dashboard Twitch Creator
CHANNEL_POINTS_REWARD_NAME=Defi aleatoire
